# Stage 3: local development only. Existing .env files are never overwritten.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://127.0.0.1:5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/kitss_education_dev
# Optional explicit override, needed in production if URI omits a DB path.
MONGODB_DB_NAME=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
MONGODB_REQUIRE_REPLICA_SET=false
STORAGE_PROVIDER=local
# Replace with an absolute directory outside frontend/public and frontend/dist.
STORAGE_LOCAL_ROOT=
STORAGE_PUBLIC_BASE_URL=/api/v1/media/public
UPLOAD_MAX_BYTES=1073741824
# Placeholders only; not required or used in Stage 2.
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional dedicated local integration DB only, never production:
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/kitss_education_test?replicaSet=rs0
# Generate a private random value of at least 32 characters; backend only.
AUTH_SECRET=
AUTH_OTP_TTL_SECONDS=600
AUTH_RESEND_SECONDS=60
AUTH_SESSION_HOURS=24
AUTH_REMEMBER_DAYS=30
AUTH_STAFF_SESSION_HOURS=8
AUTH_IDLE_MINUTES=1440
AUTH_STAFF_IDLE_MINUTES=30
# SMTP + provider-issued app password. Use 587/false (STARTTLS) or 465/true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
# Optional plain display name (mailbox stays in SMTP_FROM).
SMTP_FROM_NAME=KITSS Education

# Stage 5: trusted local ClamAV INSTREAM daemon only. Unconfigured uploads stay quarantined.
MEDIA_CLAMAV_ENABLED=false
MEDIA_CLAMAV_PORT=3310

# Stage 6: stays offline until rotation and deliberate operator validation.
RAZORPAY_CREDENTIALS_ROTATED=false

# Optional video inspection executables: command on PATH or absolute executable path.
# Never include command flags in these values. No automatic transcoding.
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_VIDEO_MAX_BYTES=268435456
MEDIA_VIDEO_UPLOAD_TIMEOUT_MS=120000
MEDIA_VIDEO_INSPECTION_TIMEOUT_MS=120000
# Reserve free disk space in addition to the maximum incoming upload size.
STORAGE_MIN_FREE_BYTES=1073741824
