{
  "name": "kitss-education-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KITSS Education modular monolith: identity, institutions, publishing, secure media and gated Test Mode commerce",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "bootstrap:admin": "node src/modules/auth/bootstrap.js",
    "test:client": "node --test ../frontend/src/shared/api/httpClient.test.js",
    "approve:razorpay-test": "node scripts/approve-razorpay.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "express": "5.3.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "mongoose": "9.11.3",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "sharp": "0.35.5"
  }
}
